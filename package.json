{
  "name": "quota-island",
  "version": "1.32.7",
  "private": true,
  "description": "A local-first desktop island for Claude, Gemini CLI and Codex quotas",
  "author": "Quota Island",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-ui.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:coverage": "npm run build && node scripts/test-coverage.cjs",
    "test:i18n": "npm run build && node scripts/i18n-test.cjs",
    "test:desktop": "npm run build && node scripts/desktop-test.cjs",
    "test:auth": "npm run build && node scripts/auth-desktop-test.cjs",
    "test:antigravity-account": "npm run build && node scripts/antigravity-account-test.cjs",
    "test:order": "npm run build && node scripts/order-test.cjs",
    "test:design": "npm run build && node scripts/design-test.cjs",
    "test:pacing": "npm run build && node scripts/pacing-test.cjs",
    "test:accounts": "npm run build && node scripts/accounts-desktop-test.cjs",
    "test:snap": "npm run build && node scripts/window-snap-test.cjs",
    "test:live": "npm run build && node scripts/soak-live-test.cjs",
    "check:live": "npm run build && node scripts/live-check.cjs",
    "check:accounts": "npm run build && electron scripts/account-check.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "test:compact-accounts": "npm run build && node scripts/compact-accounts-test.cjs",
    "test:pets": "npm run build && node scripts/pets-desktop-test.cjs",
    "test:pet-styles": "npm run build && node scripts/pet-styles-test.cjs",
    "test:pet-roaming": "npm run build && node scripts/pet-roaming-test.cjs",
    "test:pet-resident": "npm run build && node scripts/pet-resident-test.cjs",
    "test:backgrounds": "npm run build && node scripts/stage-backgrounds-test.cjs",
    "test:pet-character": "npm run build && node scripts/pet-character-test.cjs",
    "test:pet-preview-apply": "npm run build && node scripts/pet-preview-apply-test.cjs",
    "build:icons": "electron scripts/build-brand-icons.cjs",
    "test:reset-zero": "npm run build && node scripts/reset-zero-trend-test.cjs",
    "test:relative-trends": "npm run build && node scripts/relative-trends-test.cjs",
    "test:trends": "npm run build && node scripts/usage-trends-test.cjs",
    "test:task-peak": "npm run build && node scripts/task-peak-test.cjs",
    "test:tasks": "npm run build && node scripts/task-monitor-test.cjs",
    "check:tasks": "npm run build && node scripts/check-task-monitor.cjs",
    "test:sessions": "npm run build && node scripts/local-sessions-test.cjs",
    "test:native-completion": "npm run build && node scripts/native-completion-bubble-test.cjs",
    "test:idle-bubble": "npm run build && node scripts/task-idle-bubble-test.cjs",
    "test:batched-notices": "npm run build && node scripts/batched-notice-test.cjs",
    "test:task-bubble": "npm run build && node scripts/task-bubble-test.cjs",
    "check:native-tasks": "npm run build && node scripts/native-provider-tasks-test.cjs --live",
    "test:task-filter": "npm run build && node scripts/task-filter-fast-test.cjs",
    "test:task-lazy": "npm run build && node scripts/task-lazy-audit-test.cjs",
    "test:claude-web": "npm run build && electron scripts/claude-web-session-test.cjs",
    "test:messages": "npm run build && node scripts/messages-tab-test.cjs"
  },
  "build": {
    "appId": "app.quota-island.desktop",
    "productName": "Quota Pebble",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.md"
    ],
    "asar": true,
    "npmRebuild": false,
    "portable": {
      "useZip": true
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "build/icons/quota-pebble.ico",
      "signExecutable": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "zip"
    },
    "linux": {
      "category": "Development",
      "target": "AppImage"
    },
    "icon": "build/icons/quota-pebble.png",
    "asarUnpack": [
      "dist/native/*.ps1",
      "dist/native/*.exe"
    ]
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "google-auth-library": "10.9.0",
    "ws": "8.22.1"
  }
}
